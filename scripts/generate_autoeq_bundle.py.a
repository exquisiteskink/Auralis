SOFTWARE.

Measurement data inside AutoEq originates from community contributors
(oratory1990, Crinacle, Rtings, and others). Auralis redistributes derived
10-band FixedBandEQ gains only.
"""


def parse_fixed_band(text: str) -> tuple[float | None, list[float] | None]:
    pre = PREAMP_RE.search(text)
    preamp = float(pre.group(1)) if pre else None
    by_fc: dict[float, float] = {}
    for m in GAIN_RE.finditer(text):
        by_fc[float(m.group(2))] = float(m.group(3))
    if not by_fc:
        return preamp, None
    gains: list[float] = []
    for fc in BANDS:
        if fc in by_fc:
            gains.append(by_fc[fc])
            continue
        # tolerate 31.25 vs 31, etc.
        near = min(by_fc.keys(), key=lambda k: abs(k - fc))
        if abs(near - fc) > max(fc * 0.15, 2.0):
            return preamp, None
        gains.append(by_fc[near])
    return preamp, gains


