#!/usr/bin/env python3
"""Generate Auralis AutoEq preset bundle from a local AutoEq checkout.

Reads every `*FixedBandEQ.txt` under results/, maps gains onto Auralis's
10-band centers (31…16000 Hz), and emits gzip JSON — no hand-picked allowlist.

Usage:
  git clone --depth 1 https://github.com/jaakkopasanen/AutoEq.git /tmp/AutoEq
  python3 generate_autoeq_bundle.py \\
      --autoeq-root /tmp/AutoEq \\
      --out ../../samples/presets.json.gz \\
      --mode dedupe

Modes:
  full   — one record per FixedBandEQ path (~INDEX size)
  dedupe — one record per model name; prefer --priority sources (default)

Also writes sibling NOTICE (MIT stub) and MANIFEST.json next to --out when
--with-sidecar is set.
"""
from __future__ import annotations

import argparse
import gzip
import json
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

# Must match app.auralis.music.data.player.EqPresets.BANDS_HZ
BANDS = [31, 62, 125, 250, 500, 1000, 2000, 4000, 8000, 16000]

GAIN_RE = re.compile(
    r"Filter\s+(\d+):\s+ON\s+PK\s+Fc\s+(\d+(?:\.\d+)?)\s+Hz\s+Gain\s+(-?\d+(?:\.\d+)?)\s+dB",
    re.I,
)
PREAMP_RE = re.compile(r"Preamp:\s*(-?\d+(?:\.\d+)?)\s*dB", re.I)

DEFAULT_PRIORITY = [
    "oratory1990",
    "crinacle",
    "Rtings",
    "HypetheSonics",
    "Super Review",
    "Innerfidelity",
    "Kuulokenurkka",
    "Headphone.com Legacy",
]

