<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is platform-permitted so LAN HTTP can work; the app rejects
         HTTP except localhost / .local / private IP ranges. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
