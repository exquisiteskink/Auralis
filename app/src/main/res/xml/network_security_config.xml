<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Homelab Navidrome/Subsonic servers often run HTTP on LAN.
         Credentials are still sent as a salted token (never plaintext). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
